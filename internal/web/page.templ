package web

type JobView struct {
	ID         string
	Status     string
	Search     string
	Epochs     int
	Operator   string
	Score      string
	ScoresJSON       string
	RoundsJSON       string
	BeamJSON         string
	ProposalsJSON    string
	PathCountsJSON   string
	VertexCountsJSON string
	Paths            int
	Vertices         int
	Err              string
}

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="night">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		</head>
		<body class="min-h-screen">
			{ children... }
		</body>
	</html>
}

templ Home(jobs []JobView) {
	@Layout("svgolf") {
		<div class="navbar bg-base-200">
			<div class="flex-1 px-4 text-xl font-bold">svgolf</div>
		</div>
		<main class="max-w-5xl mx-auto p-4 grid gap-6">
			<div class="card bg-base-200">
				<div class="card-body">
					<h2 class="card-title">New search</h2>
					<form method="post" action="/jobs" enctype="multipart/form-data" class="grid gap-4">
						<input type="file" name="image" accept="image/png" class="file-input" required/>
						<div class="card-actions">
							<button type="submit" class="btn">Start</button>
						</div>
					</form>
				</div>
			</div>
			<div class="card bg-base-200">
				<div class="card-body">
					<h2 class="card-title">Cache</h2>
					if len(jobs) == 0 {
						<p>No jobs in the cache folder yet.</p>
					} else {
						<ul class="list">
							for _, j := range jobs {
								<li>
									<a href={ "/jobs/" + j.ID } class="link">{ j.ID }</a>
									<span class="badge">{ j.Status }</span>
									<span class="text-sm opacity-70">{ j.Operator } · { j.Epochs } epochs</span>
								</li>
							}
						</ul>
					}
				</div>
			</div>
		</main>
	}
}

templ JobPage(j JobView) {
	@Layout("svgolf " + j.ID) {
		<div class="navbar bg-base-200">
			<div class="flex-1 px-4">
				<a href="/" class="link">svgolf</a>
				<span class="mx-2">/</span>
				<span class="font-mono">{ j.ID }</span>
			</div>
			<div class="flex-none px-4 gap-2">
				<span id="status" class="badge">{ j.Status }</span>
				<span id="meta" class="text-sm">{ j.Operator } · score { j.Score } · { j.Paths } paths · { j.Vertices } vertices</span>
			</div>
		</div>
		<main class="p-4 grid gap-4" data-job={ j.ID } data-scores={ j.ScoresJSON } data-rounds={ j.RoundsJSON } data-beam={ j.BeamJSON } data-proposals={ j.ProposalsJSON } data-paths={ j.PathCountsJSON } data-vertices={ j.VertexCountsJSON }>
			<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
				@frameCard("want", "/jobs/" + j.ID + "/files/want.png")
				@frameCard("got", "/jobs/" + j.ID + "/files/last.svg")
				@frameCard("HSV delta", "/jobs/" + j.ID + "/files/last-error.png")
				@frameCard("leftover mask", "/jobs/" + j.ID + "/files/last-island.png")
			</div>
			<div class="card bg-base-200">
				<div class="card-body">
					<h2 class="card-title">Loss</h2>
					<p id="loss-scale" class="text-sm opacity-70">one point each time a proposal takes a slot. Each command costs one fully wrong pixel.</p>
					<svg id="loss" viewBox="0 0 800 200" class="w-full h-48 text-base-content" role="img" aria-label="loss of kept proposals"></svg>
				</div>
			</div>
			<div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
				<div class="card bg-base-200">
					<div class="card-body">
						<h2 class="card-title">Beam</h2>
						<p class="text-sm opacity-70">The document the ranker keeps. Every proposer claims it.</p>
						<div class="overflow-x-auto">
							<table class="table table-xs table-pin-rows">
								<thead>
									<tr>
										<th>place</th>
										<th>operator</th>
										<th>score</th>
										<th>paths</th>
										<th>commands</th>
										<th>vertices</th>
									</tr>
								</thead>
								<tbody id="beam"></tbody>
							</table>
						</div>
					</div>
				</div>
				<div class="card bg-base-200">
					<div class="card-body">
						<h2 class="card-title">Ranked batch</h2>
						<p class="text-sm opacity-70">Proposals as the ranker scores them. Keep beat the parent. Slot replaced that document.</p>
						<div class="overflow-x-auto">
							<table class="table table-xs table-pin-rows">
								<thead>
									<tr>
										<th>operator</th>
										<th>score</th>
										<th>paths</th>
										<th>commands</th>
										<th>vertices</th>
										<th>decision</th>
									</tr>
								</thead>
								<tbody id="proposals"></tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</main>
		<script>
			const root = document.querySelector("main");
			const id = root.dataset.job;
			const beamBody = document.getElementById("beam");
			const proposalBody = document.getElementById("proposals");
			let scores = [];
			let beam = [];
			let proposals = [];
			try { scores = JSON.parse(root.dataset.scores || "[]"); } catch (e) { scores = []; }
			try { beam = JSON.parse(root.dataset.beam || "[]"); } catch (e) { beam = []; }
			try { proposals = JSON.parse(root.dataset.proposals || "[]"); } catch (e) { proposals = []; }
			function cell(text, mono) {
				const td = document.createElement("td");
				if (mono) td.className = "font-mono";
				td.textContent = text;
				return td;
			}
			function paintBeam() {
				beamBody.replaceChildren();
				const rows = Array.isArray(beam) ? beam : [];
				if (rows.length === 0) {
					const tr = document.createElement("tr");
					const td = document.createElement("td");
					td.colSpan = 6;
					td.textContent = "waiting for the first kept document";
					tr.appendChild(td);
					beamBody.appendChild(tr);
					return;
				}
				rows.forEach((slot, i) => {
					const tr = document.createElement("tr");
					tr.appendChild(cell(String(i + 1), true));
					tr.appendChild(cell(slot.operator || "plate", false));
					tr.appendChild(cell(fmt(slot.score), true));
					tr.appendChild(cell(String(slot.paths), true));
					tr.appendChild(cell(String(slot.commands), true));
					tr.appendChild(cell(String(slot.vertices || 0), true));
					beamBody.appendChild(tr);
				});
			}
			function paintProposals() {
				proposalBody.replaceChildren();
				const rows = Array.isArray(proposals) ? proposals : [];
				if (rows.length === 0) {
					const tr = document.createElement("tr");
					const td = document.createElement("td");
					td.colSpan = 6;
					td.textContent = "waiting for the ranker";
					tr.appendChild(td);
					proposalBody.appendChild(tr);
					return;
				}
				for (const row of rows) {
					const tr = document.createElement("tr");
					tr.appendChild(cell(row.operator || "—", false));
					tr.appendChild(cell(fmt(row.score), true));
					tr.appendChild(cell(String(row.paths), true));
					tr.appendChild(cell(String(row.commands), true));
					tr.appendChild(cell(String(row.vertices || 0), true));
					const decision = document.createElement("td");
					const badge = document.createElement("span");
					if (row.slot) {
						badge.className = "badge badge-success badge-sm";
						badge.textContent = "slot";
					} else if (row.keep) {
						badge.className = "badge badge-warning badge-sm";
						badge.textContent = "keep";
					} else {
						badge.className = "badge badge-ghost badge-sm";
						badge.textContent = "reject";
					}
					decision.appendChild(badge);
					tr.appendChild(decision);
					proposalBody.appendChild(tr);
				}
			}
			function show() {
				for (const [sel, name] of [
					["got", "last.svg"],
					["HSV delta", "last-error.png"],
					["leftover mask", "last-island.png"],
				]) {
					const img = document.querySelector(`img[alt="${sel}"]`);
					if (img) img.src = `/jobs/${id}/files/${name}?t=${Date.now()}`;
				}
				paintBeam();
				paintProposals();
			}
			function takeFrame(d) {
				if (Array.isArray(d.beam)) beam = d.beam;
				if (Array.isArray(d.proposals)) proposals = d.proposals;
				if (Array.isArray(d.scores) && d.scores.length) scores = d.scores;
				paintBeam();
				paintProposals();
				drawLoss(scores);
			}
			function fmt(v) {
				if (!Number.isFinite(v)) return "-";
				if (Math.abs(v) >= 1e6 || (v !== 0 && Math.abs(v) < 1e-2)) return v.toExponential(2);
				return v.toFixed(2);
			}
			function drawLoss(vals) {
				const svg = document.getElementById("loss");
				const note = document.getElementById("loss-scale");
				const w = 800, h = 200;
				const pad = { l: 64, r: 16, t: 16, b: 28 };
				while (svg.firstChild) svg.removeChild(svg.firstChild);
				if (!vals.length) {
					note.textContent = "waiting for the first kept proposal";
					return;
				}
				let ymin = Math.min.apply(null, vals), ymax = Math.max.apply(null, vals);
				if (ymin === ymax) {
					ymin = ymin * 0.9;
					ymax = ymax * 1.1 || 1;
				}
				const log = ymin > 0 && ymax / ymin >= 10;
				note.textContent = log ? "log10 score · kept proposals" : "score · kept proposals";
				const yOf = (v) => {
					const a = log ? Math.log10(v) : v;
					const lo = log ? Math.log10(ymin) : ymin;
					const hi = log ? Math.log10(ymax) : ymax;
					return pad.t + (1 - (a - lo) / (hi - lo)) * (h - pad.t - pad.b);
				};
				const xOf = (i) => {
					const n = Math.max(vals.length - 1, 1);
					return pad.l + (i / n) * (w - pad.l - pad.r);
				};
				const ns = "http://www.w3.org/2000/svg";
				const el = (name, attrs) => {
					const n = document.createElementNS(ns, name);
					for (const k in (attrs || {})) n.setAttribute(k, attrs[k]);
					return n;
				};
				svg.appendChild(el("line", { x1: pad.l, y1: pad.t, x2: pad.l, y2: h - pad.b, stroke: "currentColor", "stroke-opacity": "0.35" }));
				svg.appendChild(el("line", { x1: pad.l, y1: h - pad.b, x2: w - pad.r, y2: h - pad.b, stroke: "currentColor", "stroke-opacity": "0.35" }));
				svg.appendChild(el("text", { x: 8, y: pad.t + 4, fill: "currentColor", "font-size": "11" })).textContent = fmt(ymax);
				svg.appendChild(el("text", { x: 8, y: h - pad.b, fill: "currentColor", "font-size": "11" })).textContent = fmt(ymin);
				svg.appendChild(el("text", { x: pad.l, y: h - 6, fill: "currentColor", "font-size": "11" })).textContent = "0";
				svg.appendChild(el("text", { x: w - pad.r, y: h - 6, fill: "currentColor", "font-size": "11", "text-anchor": "end" })).textContent = String(vals.length - 1);
				if (vals.length === 1) {
					svg.appendChild(el("circle", { cx: xOf(0), cy: yOf(vals[0]), r: 4, fill: "currentColor" }));
				} else {
					const d = vals.map((v, i) => (i === 0 ? "M" : "L") + xOf(i) + " " + yOf(v)).join(" ");
					svg.appendChild(el("path", { d: d, fill: "none", stroke: "currentColor", "stroke-width": "2" }));
					for (let i = 0; i < vals.length; i++) {
						const c = el("circle", { cx: xOf(i), cy: yOf(vals[i]), r: 3, fill: "currentColor" });
						c.appendChild(el("title")).textContent = "kept " + i + " · " + fmt(vals[i]);
						svg.appendChild(c);
					}
				}
			}
			drawLoss(scores);
			paintBeam();
			paintProposals();
			const es = new EventSource(`/jobs/${id}/events`);
			es.addEventListener("epoch", (ev) => {
				const d = JSON.parse(ev.data);
				document.getElementById("status").textContent = d.status;
				document.getElementById("meta").textContent =
					`${d.operator} · score ${d.score} · ${d.paths} paths · ${d.vertices} vertices · ${d.elapsed}`;
				takeFrame(d);
				show();
			});
			es.addEventListener("frame", (ev) => {
				takeFrame(JSON.parse(ev.data));
			});
			es.addEventListener("done", (ev) => {
				const d = JSON.parse(ev.data);
				document.getElementById("status").textContent = d.status;
				es.close();
			});
		</script>
	}
}

templ frameCard(title string, src string) {
	<div class="card bg-base-200">
		<figure class="bg-black">
			<img src={ src } alt={ title } class="w-full h-auto"/>
		</figure>
		<div class="card-body p-3">
			<h2 class="card-title text-sm">{ title }</h2>
		</div>
	</div>
}
