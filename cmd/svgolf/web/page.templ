package web

type JobView struct {
	ID         string
	Status     string
	Search     string
	Epochs     int
	Operator   string
	Score      string
	ScoresJSON       string
	RoundsJSON       string
	PathCountsJSON   string
	VertexCountsJSON string
	Paths            int
	Vertices         int
	Err              string
}

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="night">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		</head>
		<body class="min-h-screen">
			{ children... }
		</body>
	</html>
}

templ Home(jobs []JobView) {
	@Layout("svgolf") {
		<div class="navbar bg-base-200">
			<div class="flex-1 px-4 text-xl font-bold">svgolf</div>
		</div>
		<main class="max-w-5xl mx-auto p-4 grid gap-6">
			<div class="card bg-base-200">
				<div class="card-body">
					<h2 class="card-title">New search</h2>
					<form method="post" action="/jobs" enctype="multipart/form-data" class="grid gap-4">
						<input type="file" name="image" accept="image/png" class="file-input" required/>
						<div class="card-actions">
							<button type="submit" class="btn">Start</button>
						</div>
					</form>
				</div>
			</div>
			<div class="card bg-base-200">
				<div class="card-body">
					<h2 class="card-title">Cache</h2>
					if len(jobs) == 0 {
						<p>No jobs in the cache folder yet.</p>
					} else {
						<ul class="list">
							for _, j := range jobs {
								<li>
									<a href={ "/jobs/" + j.ID } class="link">{ j.ID }</a>
									<span class="badge">{ j.Status }</span>
									<span class="text-sm opacity-70">{ j.Operator } · { j.Epochs } epochs</span>
								</li>
							}
						</ul>
					}
				</div>
			</div>
		</main>
	}
}

templ JobPage(j JobView) {
	@Layout("svgolf " + j.ID) {
		<div class="navbar bg-base-200">
			<div class="flex-1 px-4">
				<a href="/" class="link">svgolf</a>
				<span class="mx-2">/</span>
				<span class="font-mono">{ j.ID }</span>
			</div>
			<div class="flex-none px-4 gap-2">
				<span id="status" class="badge">{ j.Status }</span>
				<span id="meta" class="text-sm">{ j.Operator } · score { j.Score } · { j.Paths } paths · { j.Vertices } vertices</span>
			</div>
		</div>
		<main class="p-4 grid gap-4" data-job={ j.ID } data-scores={ j.ScoresJSON } data-rounds={ j.RoundsJSON } data-paths={ j.PathCountsJSON } data-vertices={ j.VertexCountsJSON }>
			<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
				@frameCard("want", "/jobs/" + j.ID + "/files/want.png")
				@frameCard("got", "/jobs/" + j.ID + "/files/last.png")
				@frameCard("HSV delta", "/jobs/" + j.ID + "/files/last-error.png")
				@frameCard("hottest leftover", "/jobs/" + j.ID + "/files/last-island.png")
			</div>
			<div class="card bg-base-200">
				<div class="card-body">
					<h2 class="card-title">Loss</h2>
					<p id="loss-scale" class="text-sm opacity-70">one point per epoch</p>
					<svg id="loss" viewBox="0 0 800 200" class="w-full h-48 text-base-content" role="img" aria-label="loss over epochs"></svg>
				</div>
			</div>
			<div class="card bg-base-200">
				<div class="card-body">
					<h2 class="card-title">Epochs</h2>
					<div class="overflow-x-auto">
						<table class="table table-xs table-pin-rows">
							<thead>
								<tr id="epoch-head"></tr>
							</thead>
							<tbody id="epochs"></tbody>
						</table>
					</div>
				</div>
			</div>
		</main>
		<script>
			const root = document.querySelector("main");
			const id = root.dataset.job;
			const box = document.getElementById("epochs");
			const head = document.getElementById("epoch-head");
			let scores = [];
			let rounds = [];
			let pathCounts = [];
			let vertexCounts = [];
			try { scores = JSON.parse(root.dataset.scores || "[]"); } catch (e) { scores = []; }
			try { rounds = JSON.parse(root.dataset.rounds || "[]"); } catch (e) { rounds = []; }
			try { pathCounts = JSON.parse(root.dataset.paths || "[]"); } catch (e) { pathCounts = []; }
			try { vertexCounts = JSON.parse(root.dataset.vertices || "[]"); } catch (e) { vertexCounts = []; }
			const names = [];
			function remember(round) {
				if (!Array.isArray(round)) return;
				for (const r of round) {
					if (r && r.name && !names.includes(r.name)) names.push(r.name);
				}
			}
			for (const round of rounds) remember(round);
			function scoreOf(round, name) {
				if (!Array.isArray(round)) return undefined;
				for (const r of round) {
					if (r && r.name === name) return r;
				}
				return undefined;
			}
			function bestNames(round) {
				if (!Array.isArray(round)) return [];
				const scored = round.filter((r) => r && r.score != null);
				const flagged = scored.filter((r) => r.best).map((r) => r.name);
				if (flagged.length >= 2) return flagged;
				return scored.slice().sort((a, b) => a.score - b.score).slice(0, 3).map((r) => r.name);
			}
			function paintHead() {
				head.replaceChildren();
				const cols = ["epoch", "win", "paths", "vertices", ...names];
				for (const name of cols) {
					const th = document.createElement("th");
					th.textContent = name;
					head.appendChild(th);
				}
			}
			function paintRows() {
				box.replaceChildren();
				paintHead();
				for (let i = 0; i < scores.length; i++) {
					const tr = document.createElement("tr");
					const pad = String(i).padStart(3, "0");
					const ep = document.createElement("th");
					const a = document.createElement("a");
					a.className = "link";
					a.href = `/jobs/${id}/files/${pad}.png`;
					a.textContent = pad;
					ep.appendChild(a);
					tr.appendChild(ep);
					const win = document.createElement("td");
					const last = rounds[i];
					let chosen = "";
					if (last) {
						for (const r of last) {
							if (r && r.chosen) chosen = r.name;
						}
						if (!chosen) {
							for (const r of last) {
								if (r && r.ok && r.score != null && (chosen === "" || r.score < scoreOf(last, chosen).score)) chosen = r.name;
							}
						}
					}
					win.textContent = chosen || "—";
					tr.appendChild(win);
					const pathsCell = document.createElement("td");
					pathsCell.className = "font-mono";
					pathsCell.textContent = i < pathCounts.length ? String(pathCounts[i]) : "—";
					tr.appendChild(pathsCell);
					const verticesCell = document.createElement("td");
					verticesCell.className = "font-mono";
					verticesCell.textContent = i < vertexCounts.length ? String(vertexCounts[i]) : "—";
					tr.appendChild(verticesCell);
					const tops = bestNames(last);
					for (const name of names) {
						const td = document.createElement("td");
						td.className = "font-mono";
						const r = scoreOf(rounds[i], name);
						if (!r) td.textContent = "";
						else if (r.score == null) td.textContent = "—";
						else {
							td.textContent = fmt(r.score);
							if (r.best || tops.includes(name)) td.classList.add("underline");
							if (name === chosen) td.classList.add("font-bold");
						}
						tr.appendChild(td);
					}
					box.appendChild(tr);
				}
			}
			function show(n) {
				for (const [sel, name] of [
					["got", "last.png"],
					["HSV delta", "last-error.png"],
					["hottest leftover", "last-island.png"],
				]) {
					const img = document.querySelector(`img[alt="${sel}"]`);
					if (img) img.src = `/jobs/${id}/files/${name}?t=${Date.now()}`;
				}
				paintRows();
			}
			function fmt(v) {
				if (!Number.isFinite(v)) return "-";
				if (Math.abs(v) >= 1e6 || (v !== 0 && Math.abs(v) < 1e-2)) return v.toExponential(2);
				return v.toFixed(2);
			}
			function drawLoss(vals) {
				const svg = document.getElementById("loss");
				const note = document.getElementById("loss-scale");
				const w = 800, h = 200;
				const pad = { l: 64, r: 16, t: 16, b: 28 };
				while (svg.firstChild) svg.removeChild(svg.firstChild);
				if (!vals.length) {
					note.textContent = "waiting for the first epoch";
					return;
				}
				let ymin = Math.min.apply(null, vals), ymax = Math.max.apply(null, vals);
				if (ymin === ymax) {
					ymin = ymin * 0.9;
					ymax = ymax * 1.1 || 1;
				}
				const log = ymin > 0 && ymax / ymin >= 10;
				note.textContent = log ? "log10 score · one point per epoch" : "score · one point per epoch";
				const yOf = (v) => {
					const a = log ? Math.log10(v) : v;
					const lo = log ? Math.log10(ymin) : ymin;
					const hi = log ? Math.log10(ymax) : ymax;
					return pad.t + (1 - (a - lo) / (hi - lo)) * (h - pad.t - pad.b);
				};
				const xOf = (i) => {
					const n = Math.max(vals.length - 1, 1);
					return pad.l + (i / n) * (w - pad.l - pad.r);
				};
				const ns = "http://www.w3.org/2000/svg";
				const el = (name, attrs) => {
					const n = document.createElementNS(ns, name);
					for (const k in (attrs || {})) n.setAttribute(k, attrs[k]);
					return n;
				};
				svg.appendChild(el("line", { x1: pad.l, y1: pad.t, x2: pad.l, y2: h - pad.b, stroke: "currentColor", "stroke-opacity": "0.35" }));
				svg.appendChild(el("line", { x1: pad.l, y1: h - pad.b, x2: w - pad.r, y2: h - pad.b, stroke: "currentColor", "stroke-opacity": "0.35" }));
				svg.appendChild(el("text", { x: 8, y: pad.t + 4, fill: "currentColor", "font-size": "11" })).textContent = fmt(ymax);
				svg.appendChild(el("text", { x: 8, y: h - pad.b, fill: "currentColor", "font-size": "11" })).textContent = fmt(ymin);
				svg.appendChild(el("text", { x: pad.l, y: h - 6, fill: "currentColor", "font-size": "11" })).textContent = "0";
				svg.appendChild(el("text", { x: w - pad.r, y: h - 6, fill: "currentColor", "font-size": "11", "text-anchor": "end" })).textContent = String(vals.length - 1);
				if (vals.length === 1) {
					svg.appendChild(el("circle", { cx: xOf(0), cy: yOf(vals[0]), r: 4, fill: "currentColor" }));
				} else {
					const d = vals.map((v, i) => (i === 0 ? "M" : "L") + xOf(i) + " " + yOf(v)).join(" ");
					svg.appendChild(el("path", { d: d, fill: "none", stroke: "currentColor", "stroke-width": "2" }));
					for (let i = 0; i < vals.length; i++) {
						const c = el("circle", { cx: xOf(i), cy: yOf(vals[i]), r: 3, fill: "currentColor" });
						c.appendChild(el("title")).textContent = "epoch " + i + " · " + fmt(vals[i]);
						svg.appendChild(c);
					}
				}
			}
			drawLoss(scores);
			paintRows();
			const es = new EventSource(`/jobs/${id}/events`);
			es.addEventListener("epoch", (ev) => {
				const d = JSON.parse(ev.data);
				document.getElementById("status").textContent = d.status;
				document.getElementById("meta").textContent =
					`${d.operator} · score ${d.score} · ${d.paths} paths · ${d.vertices} vertices · ${d.elapsed}`;
				if (Array.isArray(d.scores)) scores = d.scores;
				else if (d.n >= scores.length) scores.push(parseFloat(d.score));
				if (Array.isArray(d.rounds)) {
					rounds = d.rounds;
					for (const round of rounds) remember(round);
				}
				if (Array.isArray(d.pathCounts)) pathCounts = d.pathCounts;
				if (Array.isArray(d.vertexCounts)) vertexCounts = d.vertexCounts;
				drawLoss(scores);
				show(d.n);
			});
			es.addEventListener("done", (ev) => {
				const d = JSON.parse(ev.data);
				document.getElementById("status").textContent = d.status;
				es.close();
			});
		</script>
	}
}

templ frameCard(title string, src string) {
	<div class="card bg-base-200">
		<figure class="bg-black">
			<img src={ src } alt={ title } class="w-full h-auto"/>
		</figure>
		<div class="card-body p-3">
			<h2 class="card-title text-sm">{ title }</h2>
		</div>
	</div>
}
